# Copy to .env and fill in.
DATABASE_URL=sqlite:///./vivatlas.db

# Gitea. Token is optional: only public repositories are scanned.
GITEA_URL=https://git.example.com
GITEA_TOKEN=

# Behind a proxy that terminates TLS (Cloudflare, Traefik, nginx), the request
# reaches VIVATLAS as plain http — so without this, cookies go out WITHOUT the
# Secure flag on a site the browser reached over https. Name the address the proxy
# connects FROM; in Docker that is usually the bridge gateway:
#   docker exec <container> ip route | awk '/default/ {print $3}'
# Comma-separated for several. "*" trusts whoever asks — only safe when nothing but
# the proxy can reach the port. Empty = loopback only.
TRUSTED_PROXIES=
