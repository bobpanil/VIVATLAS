<?xml version="1.0" encoding="utf-8"?>
<!-- The quiet counterpart to btn_primary: an outlined button on the ivory card,
     for the alternative route rather than the main one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_border" />
            <stroke android:width="1dp" android:color="@color/field_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field" />
            <stroke android:width="1dp" android:color="@color/field_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
