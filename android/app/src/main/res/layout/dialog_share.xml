<?xml version="1.0" encoding="utf-8"?>
<!-- "Add to VIVATLAS" — the sheet the share target puts up before it saves
     anything, so the zone is a thing you see and can change on the spot rather
     than a setting you have to remember. Ivory card + gold action, matching the
     server and leave dialogs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_dialog_title"
        android:textColor="@color/login_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- What is about to be saved: the page's own title when the sharing app
         gave us one, and the link underneath it. Read-only — this is a
         confirmation, not an edit form. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/field_bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/share_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/login_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/share_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="middle"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- The zone. Preset from the standing choice in App settings; changing it
         here applies to this share only. -->
    <RadioGroup
        android:id="@+id/share_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:background="@drawable/seg_track"
        android:padding="4dp">

        <RadioButton
            android:id="@+id/share_zone_private"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            android:button="@null"
            android:background="@drawable/seg_item"
            android:drawableStart="@drawable/ic_zone_private"
            android:drawableTint="@color/seg_ink"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/share_zone_private"
            android:textColor="@color/seg_ink"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/share_zone_shared"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            android:button="@null"
            android:background="@drawable/seg_item"
            android:drawableStart="@drawable/ic_zone_shared"
            android:drawableTint="@color/seg_ink"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/share_zone_shared"
            android:textColor="@color/seg_ink"
            android:textSize="15sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/share_zone_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/share_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="@android:string/cancel"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/share_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:text="@string/share_add"
            android:textColor="@color/link_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
